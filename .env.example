# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN pernah commit / share file .env

# Token bot dari Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# ID server Discord kamu (klik kanan nama server -> Copy Server ID)
# Dipakai supaya slash command langsung muncul di server ini
DISCORD_GUILD_ID=

# Koneksi PostgreSQL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# --- Diisi di fase berikutnya ---
GEMINI_API_KEY=
TWELVEDATA_API_KEY=
